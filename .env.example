# ---------------------------------------------------------------------------
# Copy this file to .env (root) and adjust values. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL (docker-compose.yml provides this exact local instance)
DATABASE_URL="postgresql://ps02:ps02@localhost:5432/ps02?schema=public"

# Auth
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="7d"

# API
PORT=4000
WEB_ORIGIN="http://localhost:5173"

# External services (offline-tolerant: timeout + cache + fallback)
OSRM_BASE_URL="https://router.project-osrm.org"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
HTTP_TIMEOUT_MS=3000

# Optional deterministic hackathon dispatch. Uses an existing driver account.
DEMO_MODE=false
DEMO_DRIVER_EMAIL="driver@demo.com"
DEMO_PICKUP_ETA_MIN=5

# Generate a private 32-byte key (64 hex chars) before storing driver bank details.
SENSITIVE_DATA_KEY="replace-with-64-hex-characters"

# Note: simulator speed, fleet size, city, fare and pooling settings live in
# shared/src/config.ts (single source of truth), not here.
