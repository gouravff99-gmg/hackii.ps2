{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@ps02/shared": ["../shared/src/index.ts"],
      "@ps02/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src", "prisma", "../shared/src"]
}
